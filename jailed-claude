VERSION="1.1.1"

set -euo pipefail

if [[ $# -eq 1 && "$1" == "-v" ]]; then
    echo "Jailed Claude - $VERSION"
    exit 0
fi

# Ctrl+C during any interactive selection aborts the whole script.
trap 'printf "\n>> Interrupted.\n" >&2; exit 130' INT

# Single teardown point for every exit path (normal, error, INT, TERM).
# Every command is guarded with || true: under set -e one failure must not
# abort the rest of the teardown mid-trap.
hosts_tmp=""
resolv_file=""
sidecar_name=""
strict_net=""
cleanup() {
  trap - EXIT INT TERM
  [[ -n "$hosts_tmp" ]] && rm -rf "$hosts_tmp" || true
  [[ -n "$resolv_file" ]] && rm -f "$resolv_file" || true
  if [[ -n "$sidecar_name" ]]; then docker rm -f "$sidecar_name" >/dev/null 2>&1 || true; fi
  if [[ -n "$strict_net" ]]; then docker network rm "$strict_net" >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT
trap 'printf "\n>> Terminated.\n" >&2; exit 143' TERM

die() { echo "!! $*" >&2; exit 1; }

# Strict dotted-quad check (regex + octet range), used by --strict resolution.
valid_ipv4() {
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local o
  for o in "${BASH_REMATCH[@]:1}"; do
    (( 10#$o <= 255 )) || return 1
  done
}

# Resolve this script's real path, following symlinks (so a PATH symlink works)
_SRC="${BASH_SOURCE[0]}"
while [[ -h "$_SRC" ]]; do
  _DIR="$(cd "$(dirname "$_SRC")" && pwd)"
  _SRC="$(readlink "$_SRC")"
  [[ "$_SRC" != /* ]] && _SRC="$_DIR/$_SRC"
done
SCRIPT_DIR="$(cd "$(dirname "$_SRC")" && pwd)"
IMAGE="${JAILED_CLAUDE_IMAGE:-jailed-claude:latest}"
DOCKERFILE="$SCRIPT_DIR/Dockerfile.jailed-claude"

# Fail early with a clear message if Docker is missing
if ! command -v docker >/dev/null 2>&1; then
  echo "!! 'docker' not found in PATH. Install Docker Engine (>= 20.10) first." >&2
  exit 1
fi

# ---------- Build the image if missing ----------
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo ">> Image $IMAGE not found: building it now..." >&2
  if [[ ! -f "$DOCKERFILE" ]]; then
    echo "!! Dockerfile not found at: $DOCKERFILE" >&2; exit 1
  fi
  docker build -t "$IMAGE" -f "$DOCKERFILE" "$SCRIPT_DIR"
fi


claude_galera() {
  local msg="${1:-It was just an rm * -rf ...}"
  local O=$'\e[38;5;173m'
  local G=$'\e[38;5;245m'
  local B=$'\e[1m'
  local R=$'\e[0m'
  [[ -t 1 ]] || { O=""; G=""; B=""; R=""; }


  local -a px=(
    "................"
    "................"
    "................"
    "...##########..."
    "...##.####.##..."
    ".##############."
    ".##############."
    "...##########..."
    "................"
    "....#.#..#.#...."
    "....#.#..#.#...."
    "................"
  )
  local -a hbar=(1 8)
  local -a vbar=(5 12 19 26)
  local W=$(( ${#px[0]} * 2 ))
  local r c p isv ish

  local dash; dash=$(printf '%*s' $(( ${#msg} + 4 )) '' | tr ' ' '-')
  printf '\n  .%s.\n  |  %s  |\n  '"'"'%s'"'"'\n            \\\n' "$dash" "$msg" "$dash"

  for (( r = 0; r < ${#px[@]}; r++ )); do
    ish=0; for p in "${hbar[@]}"; do (( r == p )) && ish=1; done
    printf ' '
    for (( c = 0; c < W; c++ )); do
      isv=0; for p in "${vbar[@]}"; do (( c == p )) && isv=1; done
      if   (( ish && isv )); then                printf '%s╋' "$G"
      elif (( ish && c >= 2 && c < W - 2 )); then printf '%s━' "$G"
      elif (( isv )); then                       printf '%s┃' "$G"
      elif [[ "${px[r]:c/2:1}" == "#" ]]; then   printf '%s█' "$O"
      else                                       printf ' '
      fi
    done
    printf '%s\n' "$R"
  done
  printf '\n      %sJailed Claude - By R.N.%s\n\n' "$B" "$R"
  printf '               Loading...'
  sleep 2
}


claude_galera

# ================= CONFIG =================

CONF_DIR="$SCRIPT_DIR/conf"          # folder holding the *.conf files

HOST_UID="$(id -u)"
HOST_GID="$(id -g)"
HOME_PATH="$HOME"
CUR_PATH="$(pwd)"

# Only these home entries (dir + file) are bind-mounted read-write
WHITELIST=(".claude" ".claude.json")

# These home entries are bind-mounted READ-ONLY
WHITELIST_RO=(".claude/settings.json" ".claude/commands" ".claude/agents" ".claude/skills" ".claude/hooks")

# Hosts to blackhole in --isolated mode. Fully replaceable via JAILED_CLAUDE_BLOCK_HOSTS (space separated)
BLOCK_HOSTS="${JAILED_CLAUDE_BLOCK_HOSTS:-api.anthropic.com anthropic.com www.anthropic.com console.anthropic.com statsig.anthropic.com claude.ai www.claude.ai}"

# host.docker.internal -> host gateway mapping (default: enabled).
# Disable with JAILED_ALLOW_INTERNAL=0|false|no|off to cut container->host reachability.
ALLOW_INTERNAL="${JAILED_ALLOW_INTERNAL:-1}"
case "${ALLOW_INTERNAL,,}" in
  0|false|no|off) ALLOW_INTERNAL=0 ;;
  1|true|yes|on)  ALLOW_INTERNAL=1 ;;
  *) echo "!! Unrecognized JAILED_ALLOW_INTERNAL='${JAILED_ALLOW_INTERNAL}': defaulting to enabled." >&2; ALLOW_INTERNAL=1 ;;
esac

# ---------- Parse arguments: extract --strict/--isolated, the rest goes to claude ----------
STRICT=0
ISOLATED=0
claude_args=()
for a in "$@"; do
  case "$a" in
    --strict)   STRICT=1 ;;
    --isolated) ISOLATED=1 ;;
    *)          claude_args+=("$a") ;;
  esac
done
if [[ "$STRICT" == "1" && "$ISOLATED" == "1" ]]; then
  echo ">> Note: --strict supersedes --isolated (the blocklist is not applied)." >&2
fi

# ---------- Isolation choice (only if neither flag was given) ----------
if [[ "$STRICT" != "1" && "$ISOLATED" != "1" ]]; then
  iso_modes=(
    $'isolated\tBlackholes the configured hosts, every other destination stays reachable. Isolated hosts: ['"$BLOCK_HOSTS]"
    $'normal\tNo network isolation: the container can reach any host.'
    $'strict\tL3 egress pinning: only ANTHROPIC_BASE_URL (default value if empty or from conf/env) is reachable, everything else is dropped.'
  )
  mode="isolated"               # default, also for non-interactive runs
  if [[ -t 0 ]]; then
    if command -v fzf >/dev/null 2>&1; then
      chosen="$(printf '%s\n' "${iso_modes[@]}" \
        | fzf --prompt "Isolation> " --header "Select the network isolation mode" \
              --delimiter $'\t' --with-nth 1 \
              --preview 'echo {2..}' --preview-window 'down:3:wrap')" || true
      [[ -n "$chosen" ]] && mode="${chosen%%$'\t'*}"
    else
      echo ">> Select the network isolation mode:" >&2
      for i in "${!iso_modes[@]}"; do
        printf "   %d) %-9s %s\n" "$((i+1))" "${iso_modes[$i]%%$'\t'*}" "${iso_modes[$i]#*$'\t'}" >&2
      done
      while true; do
        read -rp ">> Choice [1-${#iso_modes[@]}] (Enter = 1): " choice || { echo ">> No input." >&2; exit 130; }
        [[ -z "$choice" ]] && break
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( ${#choice} <= 9 )); then
          choice=$((10#$choice))   # force base 10 (avoids octal errors on e.g. "08")
          if (( choice >= 1 && choice <= ${#iso_modes[@]} )); then
            mode="${iso_modes[$((choice-1))]%%$'\t'*}"
            break
          fi
        fi
        echo ">> Invalid choice, try again." >&2
      done
    fi
  fi
  case "$mode" in
    strict)   STRICT=1 ;;
    isolated) ISOLATED=1 ;;
    normal)   ;;
  esac
fi
if   [[ "$STRICT" == "1" ]]; then   echo ">> Network isolation: strict (all egress pinned to ANTHROPIC_BASE_URL)" >&2
elif [[ "$ISOLATED" == "1" ]]; then echo ">> Network isolation: enabled (blocklist blackholed)" >&2
else                                echo ">> Network isolation: disabled" >&2
fi

# ---------- Configuration file selection (conf/*.conf) ----------
CHOSEN_CONF=""
conf_list=()
shopt -s nullglob
for f in "$CONF_DIR"/*.conf; do conf_list+=("$(basename "$f")"); done
shopt -u nullglob

if [[ -n "${JAILED_CONF:-}" ]]; then
  # explicit override via env (useful for automation / non-interactive)
  if [[ -f "$CONF_DIR/$JAILED_CONF" ]]; then
    CHOSEN_CONF="$CONF_DIR/$JAILED_CONF"
    echo ">> Config (from JAILED_CONF): $JAILED_CONF" >&2
  else
    echo "!! JAILED_CONF=$JAILED_CONF not found in $CONF_DIR." >&2
  fi
elif [[ ${#conf_list[@]} -gt 0 ]] && [[ -t 0 ]]; then
  if command -v fzf >/dev/null 2>&1; then
    chosen="$(printf '%s\n' "${conf_list[@]}" \
      | fzf --prompt "Conf> " --header "Select a configuration file")" || true
    [[ -n "$chosen" ]] && CHOSEN_CONF="$CONF_DIR/$chosen"
  else
    echo ">> fzf not found: install it for a nicer picker (brew/apt-get install fzf)." >&2
    echo ">> Select a configuration file:" >&2
    for i in "${!conf_list[@]}"; do
      printf "   %d) %s\n" "$((i+1))" "${conf_list[$i]}" >&2
    done
    while true; do
      read -rp ">> Choice [1-${#conf_list[@]}]: " choice || { echo ">> No input." >&2; exit 130; }
      if [[ "$choice" =~ ^[0-9]+$ ]] && (( ${#choice} <= 9 )); then
        choice=$((10#$choice))   # force base 10 (avoids octal errors on e.g. "08")
        if (( choice >= 1 && choice <= ${#conf_list[@]} )); then
          CHOSEN_CONF="$CONF_DIR/${conf_list[$((choice-1))]}"
          break
        fi
      fi
      echo ">> Invalid choice, try again." >&2
    done
  fi
elif [[ -t 0 ]]; then
  : # no .conf files -> handled by the warning block below
else
  # non-interactive and more than one conf available
  if [[ ${#conf_list[@]} -eq 1 ]]; then
    CHOSEN_CONF="$CONF_DIR/${conf_list[0]}"
    echo ">> Non-interactive: using the only available config: ${conf_list[0]}" >&2
  fi
fi

# ---------- Warn before proceeding if no config was selected/found ----------
if [[ -z "$CHOSEN_CONF" ]]; then
  echo "!! WARNING: no configuration file selected (none found in $CONF_DIR)." >&2
  echo "!! Claude will run with NO extra environment variables and only the 'default' model." >&2
  if [[ -t 0 ]]; then
    read -rp ">> Continue without a config file? [Y/n] (Ctrl+C to abort): " c || true
    case "${c,,}" in
      n|no) echo ">> Aborted." >&2; exit 1 ;;
    esac
  fi
fi

# ---------- Load properties from the chosen configuration file ----------
env_args=()
models_csv=""
base_url_conf=""
if [[ -n "$CHOSEN_CONF" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    # trim leading/trailing whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue     # blank / comment
    line="${line#export }"                              # optional "export "
    [[ "$line" != *=* ]] && { echo ">> $(basename "$CHOSEN_CONF"): ignored line: $line" >&2; continue; }
    key="${line%%=*}"
    val="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"                # trim key
    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo ">> $(basename "$CHOSEN_CONF"): invalid key ignored: $key" >&2; continue
    fi
    if [[ "$key" == "HOME" ]]; then
      echo ">> $(basename "$CHOSEN_CONF"): HOME is managed by the script, ignored." >&2; continue
    fi
    # strip surrounding quotes from value
    if [[ ${#val} -ge 2 ]]; then
      if [[ "${val:0:1}" == '"' && "${val: -1}" == '"' ]]; then val="${val:1:${#val}-2}"; fi
      if [[ "${val:0:1}" == "'" && "${val: -1}" == "'" ]]; then val="${val:1:${#val}-2}"; fi
    fi
    # special key: --strict target (conf value wins over host env); still passed to the container
    if [[ "$key" == "ANTHROPIC_BASE_URL" ]]; then base_url_conf="$val"; fi
    # special key: only for the model list, NOT passed to the container
    if [[ "$key" == "JAILED_MODELS" ]]; then
      models_csv="$val"
      continue
    fi
    env_args+=(-e "$key=$val")
  done < "$CHOSEN_CONF"
  echo ">> Env from $(basename "$CHOSEN_CONF"): ${#env_args[@]} variable(s)." >&2
else
  echo ">> No config loaded (no extra env vars, only the 'default' model)." >&2
fi

# ---------- Build the model list: default + JAILED_MODELS ----------
MODELS=("default")
if [[ -n "$models_csv" ]]; then
  IFS=',' read -ra _m <<< "$models_csv"
  for m in "${_m[@]}"; do
    m="${m#"${m%%[![:space:]]*}"}"      # trim spaces
    m="${m%"${m##*[![:space:]]}"}"
    [[ -z "$m" ]] && continue
    MODELS+=("$m")
  done
else
  echo ">> No entries in JAILED_MODELS: only the 'default' model is available." >&2
fi

# ---------- Model selection (fzf if available, otherwise numeric menu) ----------
SELECTED_MODEL="default"
if [[ -t 0 ]]; then
  if command -v fzf >/dev/null 2>&1; then
    choice="$(printf '%s\n' "${MODELS[@]}" \
      | fzf --prompt "Model> " --header "Select the model to use")" || true
    [[ -z "$choice" ]] && choice="default"     # Esc / empty -> default
    SELECTED_MODEL="$choice"
  else
    echo ">> fzf not found: install it for a nicer picker (brew/apt-get install fzf)." >&2
    echo ">> Select the model:" >&2
    for i in "${!MODELS[@]}"; do
      printf "   %d) %s\n" "$((i+1))" "${MODELS[$i]}" >&2
    done
    while true; do
      read -rp ">> Choice [1-${#MODELS[@]}] (Enter = 1): " choice || { echo ">> No input." >&2; exit 130; }
      [[ -z "$choice" ]] && choice=1
      if [[ "$choice" =~ ^[0-9]+$ ]] && (( ${#choice} <= 9 )); then
        choice=$((10#$choice))   # force base 10 (avoids octal errors on e.g. "08")
        if (( choice >= 1 && choice <= ${#MODELS[@]} )); then
          SELECTED_MODEL="${MODELS[$((choice-1))]}"
          break
        fi
      fi
      echo ">> Invalid choice, try again." >&2
    done
  fi
else
  echo ">> Non-interactive: using 'default' (no model forced)." >&2
fi

# default -> pass nothing; otherwise force the model
model_args=()
if [[ "$SELECTED_MODEL" != "default" ]]; then
  model_args+=(--model "$SELECTED_MODEL")
fi
echo ">> Model: $SELECTED_MODEL" >&2

# ---------- Bind mounts ----------
volumes=()
volumes+=(-v "$CUR_PATH:$CUR_PATH")                 # cwd, same path
if [[ "$CUR_PATH" != "$HOME_PATH" ]]; then
  for rel in "${WHITELIST[@]}"; do                  # only .claude/ and .claude.json (read-write)
    src="$HOME_PATH/$rel"
    [[ -e "$src" ]] || continue
    volumes+=(-v "$src:$src")
  done
  for rel in "${WHITELIST_RO[@]}"; do               # nested read-only overrides
    src="$HOME_PATH/$rel"
    [[ -e "$src" ]] || continue
    volumes+=(-v "$src:$src:ro")
  done
fi

# ---------- Network lockdown: --strict (egress pinning) or --isolated (blocklist) ----------
extra_args=()
if [[ "$STRICT" == "1" ]]; then

  # ----- Target: ANTHROPIC_BASE_URL from the selected conf, else host env -----
  BASE_URL="${base_url_conf:-${ANTHROPIC_BASE_URL:-}}"
  if [[ -z "$BASE_URL" ]]; then
    die "--strict needs ANTHROPIC_BASE_URL (in the selected conf file or in your environment)."
  fi
  # Host-env fallback: forward it, or Claude Code would default to the (blocked) Anthropic API
  if [[ -z "$base_url_conf" ]]; then env_args+=(-e "ANTHROPIC_BASE_URL=$BASE_URL"); fi
  # No telemetry/auto-update/error reporting: it could only hit the drop policy (appended last: wins over the conf)
  env_args+=(-e "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1")

  # ----- Parse scheme://[user@]host[:port][/path?query#frag] -----
  if ! [[ "$BASE_URL" =~ ^([A-Za-z][A-Za-z0-9+.-]*)://(.+)$ ]]; then
    die "ANTHROPIC_BASE_URL is not a valid URL: '$BASE_URL'"
  fi
  SCHEME="${BASH_REMATCH[1],,}"
  REST="${BASH_REMATCH[2]}"
  case "$SCHEME" in
    http|https) ;;
    *) die "unsupported scheme '$SCHEME' in ANTHROPIC_BASE_URL (only http/https)" ;;
  esac
  HOSTPORT="${REST%%[/?#]*}"                # authority: cut at first / ? or #
  HOSTPORT="${HOSTPORT##*@}"                # then drop userinfo, if any (an '@' in the path is not userinfo)
  case "$HOSTPORT" in
    \[*) die "IPv6 targets are not supported by --strict (got '$BASE_URL')" ;;
  esac
  colons="${HOSTPORT//[^:]/}"               # keep only the ':' characters
  if (( ${#colons} > 1 )); then
    die "IPv6 targets are not supported by --strict (got '$BASE_URL')"
  fi
  T_HOST="${HOSTPORT%%:*}"
  if [[ "$HOSTPORT" == *:* ]]; then T_PORT="${HOSTPORT##*:}"; else T_PORT=""; fi
  if [[ -z "$T_HOST" ]]; then die "no host in ANTHROPIC_BASE_URL: '$BASE_URL'"; fi
  if [[ -z "$T_PORT" ]]; then
    if [[ "$SCHEME" == "http" ]]; then T_PORT=80; else T_PORT=443; fi
  else
    if ! [[ "$T_PORT" =~ ^[0-9]{1,5}$ ]]; then die "invalid port in ANTHROPIC_BASE_URL: '$T_PORT'"; fi
    if (( T_PORT < 1 || T_PORT > 65535 )); then die "port out of range in ANTHROPIC_BASE_URL: $T_PORT"; fi
  fi

  # ----- Resolve to IPv4 on the host (fail-closed) -----
  STRICT_IPS=()
  if valid_ipv4 "$T_HOST"; then
    STRICT_IPS=("$T_HOST")                  # IP-literal target (e.g. a private gateway)
  else
    if ! [[ "$T_HOST" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]; then
      die "invalid hostname: '$T_HOST'"
    fi
    if command -v getent >/dev/null 2>&1; then
      RESOLVED="$(getent ahostsv4 "$T_HOST" 2>/dev/null | awk '{print $1}' || true)"
    elif command -v dig >/dev/null 2>&1; then
      RESOLVED="$(dig +short A "$T_HOST" 2>/dev/null || true)"
    else
      die "need 'getent' or 'dig' on the host to resolve '$T_HOST'"
    fi
    while IFS= read -r ip; do
      if [[ -n "$ip" ]] && valid_ipv4 "$ip"; then STRICT_IPS+=("$ip"); fi
    done <<< "$(printf '%s\n' "$RESOLVED" | sort -u)"
  fi
  if (( ${#STRICT_IPS[@]} == 0 )); then
    die "'$T_HOST' did not resolve to any IPv4 address (fail-closed; IPv6-only targets are unsupported)."
  fi
  echo ">> --strict target: $T_HOST port $T_PORT -> ${STRICT_IPS[*]}" >&2

  # ----- Pin hostname -> IPs in /etc/hosts, kill all other DNS resolution -----
  hosts_tmp="$(mktemp -d)"
  {
    echo "127.0.0.1 localhost"
    echo "::1       localhost ip6-localhost ip6-loopback"
    for ip in "${STRICT_IPS[@]}"; do echo "$ip $T_HOST"; done
  } > "$hosts_tmp/hosts"

  resolv_file="$(mktemp)"
  printf 'nameserver 127.0.0.53\n' > "$resolv_file"   # dead: non-target lookups fail fast

  # ----- Sidecar applies the nftables pin in a fresh netns, main joins it -----
  sidecar_name="jailed_strict_$$"
  strict_net="jailed_strict_net_$$"

  docker network create "$strict_net" >/dev/null || die "failed to create network '$strict_net'"

  docker run -d \
    --name "$sidecar_name" \
    --network "$strict_net" \
    --cap-drop=ALL --cap-add=NET_ADMIN \
    --security-opt no-new-privileges \
    -e STRICT_TARGET_IPS="${STRICT_IPS[*]}" \
    -e STRICT_TARGET_PORT="$T_PORT" \
    "$IMAGE" /usr/local/lib/jailed-claude/strict-init.sh >/dev/null \
    || die "failed to start the strict sidecar (check 'docker ps -a --filter name=jailed_strict' for orphans)"

  # Readiness wait — fail-closed. Distinguishes "slow to start" from "failed":
  # an exited sidecar is reported immediately with its logs (which carry the
  # strict-init failure reason, e.g. missing 'nft' on a custom image).
  READY_TIMEOUT="${JAILED_STRICT_READY_TIMEOUT:-15}"
  [[ "$READY_TIMEOUT" =~ ^[0-9]+$ ]] || READY_TIMEOUT=15
  ready=0
  for (( i = 0; i < READY_TIMEOUT * 2; i++ )); do
    if docker exec "$sidecar_name" test -f /run/jailed-strict-ready >/dev/null 2>&1; then
      ready=1; break
    fi
    state="$(docker inspect -f '{{.State.Status}}' "$sidecar_name" 2>/dev/null || true)"
    if [[ "$state" == "exited" ]]; then
      echo "!! --strict: sidecar exited before applying the ruleset:" >&2
      docker logs "$sidecar_name" >&2 || true
      exit 1
    fi
    sleep 0.5
  done
  if (( ready == 0 )); then
    die "--strict: sidecar not ready within ${READY_TIMEOUT}s (tune with JAILED_STRICT_READY_TIMEOUT)."
  fi

  extra_args+=(--network "container:$sidecar_name")
  extra_args+=(-v "$hosts_tmp/hosts:/etc/hosts:ro" -v "$resolv_file:/etc/resolv.conf:ro")
  echo ">> --strict active: egress pinned to $T_HOST (tcp/$T_PORT) — everything else is dropped at L3." >&2

elif [[ "$ISOLATED" == "1" ]]; then
  # Validate the blocklist: skip malformed entries, but abort if nothing valid
  # remains (an empty list would silently disable isolation).
  valid_hosts=()
  for d in $BLOCK_HOSTS; do
    if [[ "$d" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] && [[ "$d" != *..* ]]; then
      valid_hosts+=("$d")
    else
      echo "!! Ignoring malformed host in blocklist: '$d'" >&2
    fi
  done
  if (( ${#valid_hosts[@]} == 0 )); then
    echo "!! No valid hosts in the blocklist (JAILED_CLAUDE_BLOCK_HOSTS): refusing to run isolated." >&2
    exit 1
  fi

  hosts_tmp="$(mktemp -d)"
  {
    echo "127.0.0.1 localhost"
    echo "::1       localhost ip6-localhost ip6-loopback"
    for d in "${valid_hosts[@]}"; do
      echo "127.0.0.1 $d"
      echo "::1       $d"
    done
  } > "$hosts_tmp/hosts"
  extra_args+=(-v "$hosts_tmp/hosts:/etc/hosts:ro")
  echo ">> --isolated active: ${#valid_hosts[@]} host(s) -> localhost (blocked): ${valid_hosts[*]}" >&2
fi

# ---------- host.docker.internal mapping (JAILED_ALLOW_INTERNAL, default: enabled) ----------
if [[ "$STRICT" == "1" ]]; then
  # Forced off in strict mode (and avoids --add-host on a --network container: run).
  echo ">> host.docker.internal: NOT mapped (forced off in --strict mode)." >&2
elif [[ "$ALLOW_INTERNAL" == "1" ]]; then
  extra_args+=(--add-host=host.docker.internal:host-gateway)
else
  echo ">> host.docker.internal: NOT mapped (JAILED_ALLOW_INTERNAL=${JAILED_ALLOW_INTERNAL})." >&2
  for kv in ${env_args[@]+"${env_args[@]}"}; do
    if [[ "$kv" == *host.docker.internal* ]]; then
      echo "!! WARNING: '$kv' references host.docker.internal, which is unreachable with the mapping disabled." >&2
    fi
  done
fi

# ---------- Run ... into the jail! ----------
docker run --rm -it \
  --init \
  --user "$HOST_UID:$HOST_GID" \
  --cap-drop=ALL \
  --security-opt no-new-privileges \
  -e HOME="$HOME_PATH" \
  ${env_args[@]+"${env_args[@]}"} \
  "${volumes[@]}" \
  ${extra_args[@]+"${extra_args[@]}"} \
  -w "$CUR_PATH" \
  "$IMAGE" \
  claude ${model_args[@]+"${model_args[@]}"} ${claude_args[@]+"${claude_args[@]}"}
